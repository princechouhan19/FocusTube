{
  "manifest_version": 3,
  "name": "FocusTube - Productivity & Distraction Control",
  "version": "1.0.1",
  "description": "Take control of YouTube: block distractions, hide ads, and boost your productivity with advanced UI controls.",
  "permissions": ["storage", "tabs", "scripting", "downloads", "activeTab", "tabCapture", "offscreen"],
  "host_permissions": [
    "<all_urls>",
    "https://*.youtube.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.mistral.ai/*",
    "https://api.deepseek.com/*",
    "https://api.x.ai/*"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "public/icons/icon16.png",
      "48": "public/icons/icon48.png",
      "128": "public/icons/icon128.png"
    }
  },
  "icons": {
    "16": "public/icons/icon16.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/content/core/logger.js",
        "src/content/core/event-listener-utils.js",
        "src/content/core/sanitize-html.js",
        "src/content/utils/universal-screenshot.js",
        "src/content/blocking/site-blocker.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.youtube.com/*"],
      "js": [
        "src/content/core/logger.js",
        "src/content/core/event-listener-utils.js",
        "src/content/core/sanitize-html.js",
        "src/content/core/storage.js",
        "src/content/core/dom-helpers.js",
        "src/content/youtube/time-blocker.js",
        "src/content/blocking/ad-blocker.js",
        "src/content/blocking/shorts-blocker.js",
        "src/content/youtube/autoplay-controller.js",
        "src/content/youtube/quality-controller.js",
        "src/content/controllers/home-controller.js",
        "src/content/controllers/navigation-controller.js",
        "src/content/controllers/header-controller.js",
        "src/content/youtube/summary-button.js",
        "src/content/youtube/video-player-controller.js",
        "src/content/blocking/keyword-blocker.js",
        "src/content/blocking/channel-blocker.js",
        "src/content/blocking/url-blocker.js",
        "src/content/utils/auto-pause.js",
        "src/content/utils/theater-mode.js",
        "src/content/utils/metrics-hider.js",
        "src/content/utils/glass-theme.js",
        "src/content/blocking/css-filter.js",
        "src/content/utils/comment-hider.js",
        "src/content/utils/cards-hider.js",
        "src/content/ui/content.js"
      ],
      "css": ["src/content/ui/content.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "public/icons/*",
        "src/icons/banner.png"
      ],
      "matches": ["https://*.youtube.com/*"]
    }
  ],
  "commands": {
    "take-screenshot": {
      "suggested_key": {
        "default": "Ctrl+S",
        "mac": "Command+S"
      },
      "description": "Capture a screenshot of the current video frame"
    },
    "toggle-recording": {
      "suggested_key": {
        "default": "Ctrl+Shift+R",
        "mac": "Command+Shift+R"
      },
      "description": "Start or stop screen recording"
    }
  }
}
